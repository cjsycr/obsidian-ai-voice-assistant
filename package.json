{
  "name": "obsidian-ai-whispers",
  "version": "0.5.0",
  "description": "AI Whispers — a lightweight AI side panel powered by local Codex",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:bundle": "node scripts/create-release-bundle.mjs",
    "release:check": "node scripts/check-release-version.mjs",
    "release:all": "npm run build && node scripts/check-release-version.mjs && node scripts/create-release-bundle.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "codex",
    "ai"
  ],
  "author": "风瞳君",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^15.0.0",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0"
  }
}
